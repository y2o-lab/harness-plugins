{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness settings v1",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "quality": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/checkName" },
      "additionalProperties": false,
      "patternProperties": {
        "^(?!(lint|format|typecheck|test|build)$).+$": { "required": ["command"] },
        "^.+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["off", "advisory", "required"] },
            "strategy": { "enum": ["changed", "affected", "all"] },
            "dependsOn": { "$ref": "#/$defs/capabilityList" },
            "provider": { "type": "string" },
            "command": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/capabilityList" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000, "default": 120000 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 8, "default": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "default": 8192 }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dangerousCommands": { "$ref": "#/$defs/modePolicy" },
        "protectedFiles": { "$ref": "#/$defs/modePolicy" },
        "secrets": { "$ref": "#/$defs/modePolicy" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["off", "advisory"] },
        "issueMode": { "enum": ["off", "manual"] },
        "repositoryThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "pluginThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "checkName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": { "enum": ["stop", "constructor"] } },
    "capabilityList": {
      "type": "array",
      "items": { "$ref": "#/$defs/checkName" }
    },
    "modePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "mode": { "enum": ["off", "advisory", "required"] } }
    }
  }
}
